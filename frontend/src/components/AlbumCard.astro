---
import { getOptimizedImageUrl } from '../lib/image-utils'
import { url } from '../utils/url-utils'

interface Props {
  album: {
    _id: string;
    slug: string;
    title: string;
    description?: string;
    coverImage?: string;
    images?: any[];
    viewCount?: number;
    publishedAt?: string;
  };
  index?: number;
}

const { album, index = 0 } = Astro.props;

const imageObjs = (Array.isArray(album.images) ? album.images : []).filter(
  (img: any) => img && typeof img === 'object' && img.url,
);

const imageCount = imageObjs.length;

const coverObj = imageObjs.find((img: any) => img.url === album.coverImage) ?? imageObjs[0] ?? null;
const coverRaw = album.coverImage || (coverObj?.url ?? null);
const coverOrientation = coverObj?.orientation ?? 0;

function thumbUrl(src: string | undefined, w: number, version?: number) {
  if (!src) return '/default-avatar.svg';
  return getOptimizedImageUrl(src, w, 85, version ?? 0);
}

const coverUrl = thumbUrl(coverRaw ?? undefined, 800, coverOrientation);
const albumUrl = url(`/gallery/${album.slug}`);

const dateLabel = album.publishedAt
  ? new Date(album.publishedAt).toLocaleDateString('es-ES', {
      year: 'numeric',
      month: 'short',
    })
  : null;
---

<a href={albumUrl} class="album-card group" aria-label={album.title}>
  <div class="album-card__frame">
    <img
      src={coverUrl}
      alt={album.title}
      class="album-card__img"
      loading="lazy"
      draggable="false"
      onerror="this.onerror=null; this.src='/default-avatar.svg'"
    />
    <span class="album-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <div class="album-card__meta">
    <h3 class="album-card__title">{album.title}</h3>
    <p class="album-card__sub">
      {imageCount} {imageCount === 1 ? 'foto' : 'fotos'}{dateLabel && ` · ${dateLabel}`}
    </p>
  </div>
</a>

<style>
  .album-card {
    display: block;
    text-decoration: none;
  }

  .album-card__frame {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--btn-regular-bg);
  }

  .album-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    user-select: none;
  }
  .album-card:hover .album-card__img,
  .album-card:focus-visible .album-card__img {
    transform: scale(1.06);
  }

  .album-card__index {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    color: white;
    background: rgba(3, 6, 10, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    padding: 0.2rem 0.5rem;
  }

  .album-card__meta {
    padding: 0.75rem 0.1rem 0;
  }

  .album-card__title {
    font-family: 'Space Grotesk Variable', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: color-mix(in oklab, var(--deep-text) 92%, transparent);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.25s ease;
  }
  .album-card:hover .album-card__title {
    color: var(--primary);
  }

  .album-card__sub {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--deep-text);
    opacity: 0.55;
    margin: 0.25rem 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .album-card__img { transition: none; filter: none; transform: none; }
    .album-card:hover .album-card__img { transform: none; }
  }
</style>
