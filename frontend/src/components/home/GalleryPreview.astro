---
import { getOptimizedImageUrl } from '@/lib/image-utils';
import type { GalleryAlbum } from '@utils/api-blog';
import { fetchPublicAlbums } from '@utils/api-blog';

interface Props {
  config?: Record<string, unknown>;
}

const { config = {} } = Astro.props;

const ctaText = (config.ctaText as string) ?? 'Ver galería completa';
const ctaHref = (config.ctaHref as string) ?? '/gallery/';

const albumSlugsFilter = Array.isArray(config.albumSlugs) ? config.albumSlugs as string[] : [];

let albums: GalleryAlbum[] = [];
try {
  const res = await fetchPublicAlbums();
  albums = res?.albums ?? [];
  if (albumSlugsFilter.length > 0) {
    albums = albums.filter((a) => albumSlugsFilter.includes(a.slug));
  }
  // Solo álbumes con cover para evitar placeholders vacíos
  albums = albums.filter((a) => a.coverImage).slice(0, 6);
} catch (_) {}
---

{albums.length > 0 && (
  <div class="filmstrip full-bleed">
    <div class="filmstrip__track hide-scrollbar">
      {albums.map((album, i) => {
        const cover = getOptimizedImageUrl(album.coverImage!, 1200, 85);
        return (
          <a href={`/gallery/${album.slug}/`} class="filmstrip__item" aria-label={album.title}>
            <img
              src={cover}
              alt={album.title}
              class="filmstrip__img"
              loading="lazy"
              draggable="false"
            />
            <div class="filmstrip__caption">
              <span class="filmstrip__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="filmstrip__name">{album.title}</span>
            </div>
          </a>
        );
      })}

      <a href={ctaHref} class="filmstrip__more" aria-label={ctaText}>
        <span class="filmstrip__more-text">{ctaText}</span>
        <span class="filmstrip__more-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
)}

<style>
  .filmstrip {
    position: relative;
  }

  /* Pista horizontal con snap; padding lateral alinea la primera foto con el contenido */
  .filmstrip__track {
    display: flex;
    gap: clamp(0.5rem, 1vw, 0.85rem);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-inline: max(calc(50vw - var(--page-width, 75rem) / 2 + 1rem), 1.5rem);
    padding-block: 0.25rem;
    -webkit-overflow-scrolling: touch;
  }

  .filmstrip__item {
    position: relative;
    flex-shrink: 0;
    scroll-snap-align: start;
    height: clamp(20rem, 52vh, 32rem);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    text-decoration: none;
    background: var(--btn-regular-bg);
  }

  .filmstrip__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    user-select: none;
  }
  .filmstrip__item:hover .filmstrip__img,
  .filmstrip__item:focus-visible .filmstrip__img {
    transform: scale(1.06);
  }

  .filmstrip__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 2.25rem 1.1rem 0.9rem;
    background: linear-gradient(to top, rgba(3,6,10,0.72), transparent);
    color: white;
  }

  .filmstrip__index {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }

  .filmstrip__name {
    font-family: 'Space Grotesk Variable', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Tile final: CTA editorial */
  .filmstrip__more {
    flex-shrink: 0;
    scroll-snap-align: start;
    height: clamp(20rem, 52vh, 32rem);
    aspect-ratio: 3 / 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--line-divider);
    text-decoration: none;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .filmstrip__more:hover {
    background: var(--btn-plain-bg-hover);
    border-color: var(--primary);
  }
  .filmstrip__more:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .filmstrip__more-text {
    font-family: 'Space Grotesk Variable', sans-serif;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: color-mix(in oklab, var(--deep-text) 92%, transparent);
    max-width: 12ch;
  }

  .filmstrip__more-arrow {
    font-size: 1.6rem;
    color: var(--primary);
    transition: transform 0.25s ease;
  }
  .filmstrip__more:hover .filmstrip__more-arrow {
    transform: translateX(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .filmstrip__img { transition: none; filter: none; transform: none; }
    .filmstrip__item:hover .filmstrip__img { transform: none; }
    .filmstrip__more-arrow { transition: none; }
  }
</style>
