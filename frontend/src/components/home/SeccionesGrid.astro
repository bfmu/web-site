---
interface Props {
  config?: Record<string, unknown>;
}

const { config = {} } = Astro.props;

const defaultItems = [
  { titulo: 'Música que me inspira', descripcion: 'Canciones y playlists que forman parte de mi día a día.', enlace: '/music/' },
  { titulo: 'Exploraciones artísticas', descripcion: 'Fotografía y momentos que inspiran.', enlace: '/gallery/' },
  { titulo: 'Resúmenes y opiniones', descripcion: 'Libros que leo y reflexiones sobre ellos.', enlace: '/blogs/' },
  { titulo: 'Guías y artículos', descripcion: 'Soluciones y optimización de procesos.', enlace: '/archive/' },
  { titulo: 'Libros', descripcion: 'Los libros que estoy leyendo y mis notas sobre ellos.', enlace: '/books/' },
  { titulo: 'Portafolio', descripcion: 'Proyectos destacados de desarrollo de software.', enlace: 'https://portfolio.bfmu.dev' },
];

const rawItems =
  Array.isArray(config.items) && config.items.length > 0
    ? (config.items as Array<{ titulo: string; descripcion: string; enlace: string }>)
    : defaultItems;

// El CMS puede traer emojis heredados en los títulos — el índice editorial es tipográfico
function cleanTitle(t: string): string {
  // Pictogramas + variation selector (FE0F) + zero-width joiner (200D)
  return t.replace(/^(?:\p{Extended_Pictographic}|\uFE0F|\u200D|\s)+/gu, '').trim() || t;
}

const items = rawItems.map((item) => ({ ...item, titulo: cleanTitle(item.titulo) }));
---

<nav class="index-list" aria-label="Secciones del sitio">
  {items.map((item, i) => {
    const isExternal = item.enlace.startsWith('http');
    return (
      <a
        href={item.enlace}
        class="index-row"
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
      >
        <span class="index-row__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="index-row__title">{item.titulo}</span>
        <span class="index-row__desc">{item.descripcion}</span>
        <span class="index-row__arrow" aria-hidden="true">{isExternal ? '↗' : '→'}</span>
      </a>
    );
  })}
</nav>

<style>
  .index-list {
    display: block;
    border-top: 1px solid var(--line-divider);
  }

  .index-row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    grid-template-areas: 'num title arrow' 'num desc arrow';
    align-items: baseline;
    column-gap: 1rem;
    padding: clamp(1.2rem, 2.6vw, 1.9rem) 0.5rem;
    border-bottom: 1px solid var(--line-divider);
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .index-row:hover {
    background: var(--btn-plain-bg-hover);
  }
  .index-row:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: -2px;
  }

  .index-row__num {
    grid-area: num;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--primary);
    align-self: start;
    padding-top: 0.45em;
  }

  .index-row__title {
    grid-area: title;
    font-family: 'Space Grotesk Variable', sans-serif;
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: color-mix(in oklab, var(--deep-text) 90%, transparent);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), color 0.25s ease;
  }
  .index-row:hover .index-row__title {
    transform: translateX(0.6rem);
    color: var(--primary);
  }

  .index-row__desc {
    grid-area: desc;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--deep-text);
    opacity: 0.6;
    margin-top: 0.3rem;
    max-width: 34rem;
  }

  .index-row__arrow {
    grid-area: arrow;
    align-self: center;
    font-size: 1.3rem;
    color: var(--primary);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .index-row:hover .index-row__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 560px) {
    .index-row {
      grid-template-columns: 2.2rem 1fr auto;
    }
    .index-row__desc { display: none; }
    .index-row__arrow { opacity: 0.5; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-row,
    .index-row__title,
    .index-row__arrow { transition: none; }
    .index-row:hover .index-row__title { transform: none; }
    .index-row__arrow { opacity: 0.5; transform: none; }
  }
</style>
