---
// @ts-ignore path alias
import MainLayout from '@layouts/MainLayout.astro'
---
<MainLayout title="404 – Página no encontrada">
  <section class="w-full flex flex-col items-start justify-center py-24 px-6 md:px-10 pointer-events-auto max-w-[var(--page-width)] mx-auto" style="min-height:60vh">
    <p class="font-mono text-xs tracking-[0.22em] uppercase text-[var(--primary)] mb-4 transition">
      Error — página no encontrada
    </p>
    <div class="font-display font-semibold leading-none tracking-tighter text-90 transition text-[clamp(6rem,22vw,16rem)]" aria-hidden="true">
      404
    </div>
    <p class="text-lg md:text-xl text-50 mt-6 mb-10 transition max-w-xl">
      La página que buscás no existe, se movió, o nunca estuvo acá.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-3 px-7 py-3 rounded-full border border-[var(--line-divider)]
             font-mono text-xs font-medium tracking-[0.14em] uppercase text-75
             transition hover:border-[var(--primary)] hover:text-[var(--primary)] hover:bg-[var(--btn-plain-bg-hover)] active:scale-95"
    >
      Volver al inicio <span aria-hidden="true">→</span>
    </a>
  </section>
</MainLayout>
