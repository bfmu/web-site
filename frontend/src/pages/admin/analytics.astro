---
import AdminLayout from '@components/admin/AdminLayout.astro';
---

<AdminLayout title="Analytics">
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Analytics de Visitantes</h1>
      <select
        id="analytics-range"
        class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-700 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300"
      >
        <option value="7">Últimos 7 días</option>
        <option value="30" selected>Últimos 30 días</option>
        <option value="90">Últimos 90 días</option>
        <option value="365">Último año</option>
      </select>
    </div>

    <!-- Stat cards -->
    <div id="analytics-stats-cards" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800 animate-pulse">
        <div class="h-4 w-24 rounded bg-gray-200 dark:bg-gray-700"></div>
        <div class="mt-2 h-8 w-16 rounded bg-gray-200 dark:bg-gray-700"></div>
      </div>
    </div>

    <!-- Vistas por día -->
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <h3 class="mb-4 text-lg font-semibold text-gray-900 dark:text-white">Vistas por día</h3>
      <div id="analytics-chart-views" style="height: 280px;"></div>
    </div>

    <!-- Mapa de visitantes -->
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Desde dónde te visitan</h3>
      <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">
        Color = vistas por país (más oscuro = más visitas). Puntos naranjas = ciudades exactas, tamaño según cantidad de vistas.
      </p>
      <div id="analytics-chart-worldmap" style="height: 420px;"></div>
    </div>

    <!-- Flujo de navegación + Actividad -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Flujo de navegación</h3>
        <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">
          Transiciones entre páginas dentro de una misma sesión (se excluyen sesiones de una sola página)
        </p>
        <div id="analytics-chart-sankey" style="height: 340px;"></div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Actividad por hora y día</h3>
        <p class="mb-4 text-xs text-gray-500 dark:text-gray-400">
          Basado en las visitas recientes cargadas en la tabla de abajo
        </p>
        <div id="analytics-chart-heatmap" style="height: 340px;"></div>
      </div>
    </div>

    <!-- Engagement -->
    <div class="space-y-4">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Engagement</h2>
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
          <h3 class="mb-4 text-sm font-semibold text-gray-900 dark:text-white">Tiempo promedio en página</h3>
          <div id="analytics-chart-time" style="height: 260px;"></div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
          <h3 class="mb-4 text-sm font-semibold text-gray-900 dark:text-white">Scroll depth promedio</h3>
          <div id="analytics-chart-scroll" style="height: 260px;"></div>
        </div>
        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
          <h3 class="mb-4 text-sm font-semibold text-gray-900 dark:text-white">Elementos más clickeados</h3>
          <div id="analytics-chart-clicks" style="height: 260px;"></div>
        </div>
      </div>
    </div>

    <!-- Tablas -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <div id="analytics-top-pages" class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Páginas más visitadas</h3>
        </div>
        <div id="analytics-top-pages-body" class="divide-y divide-gray-200 dark:divide-gray-700">
          <div class="px-6 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Cargando…</div>
        </div>
      </div>
      <div id="analytics-top-locations" class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Visitantes por ubicación</h3>
        </div>
        <div id="analytics-top-locations-body" class="divide-y divide-gray-200 dark:divide-gray-700">
          <div class="px-6 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Cargando…</div>
        </div>
      </div>
      <div id="analytics-recent-visits" class="rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Últimas visitas</h3>
        </div>
        <div id="analytics-recent-visits-body" class="divide-y divide-gray-200 dark:divide-gray-700 max-h-80 overflow-y-auto">
          <div class="px-6 py-8 text-center text-sm text-gray-500 dark:text-gray-400">Cargando…</div>
        </div>
        <div class="border-t border-gray-200 px-6 py-3 dark:border-gray-700">
          <button
            id="analytics-load-more"
            type="button"
            class="w-full rounded-md border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-600 transition-colors hover:bg-gray-50 disabled:opacity-50 dark:border-gray-600 dark:text-gray-400 dark:hover:bg-gray-700"
            style="display: none;"
          >
            Cargar más
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
